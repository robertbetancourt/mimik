{
  "expo": {
    "name": "Mimik",
    "slug": "mimik",
    "version": "1.0.0",
    "scheme": "mimik",
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7ED",
        "foregroundImage": "./assets/app-icons/android-icon-foreground.png",
        "backgroundImage": "./assets/app-icons/android-icon-background.png",
        "monochromeImage": "./assets/app-icons/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7ED"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
